{
  "version": 2,
  "name": "llm-med-review-tracker",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    },
    "scripts/run-bulk-scraper.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape-daily",
      "schedule": "0 2 * * *"
    }
  ],
  "regions": ["iad1"],
  "framework": "nextjs"
}
