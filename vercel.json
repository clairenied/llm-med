{
  "framework": "nextjs",
  "buildCommand": "prisma migrate deploy && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "env": {
    "PRISMA_GENERATE_DATAPROXY": "true"
  },
  "crons": [
    {
      "path": "/api/cron/scrape-daily",
      "schedule": "0 2 * * *"
    }
  ]
}
