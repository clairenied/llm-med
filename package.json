{
  "name": "temp-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "prisma generate && next build",
    "postbuild": "prisma migrate deploy",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "test:deploy": "./database-ops/deploy-test.sh",
    "cleanup:fake-data": "tsx database-ops/cleanup-fake-data.ts",
    "cleanup:production": "tsx database-ops/cleanup-production-fake-data.ts",
    "cleanup:duplicates": "tsx database-ops/cleanup-duplicates.ts",
    "scrape:inngest": "curl -X POST http://localhost:3010/api/admin/scrape-inngest",
    "scrape:inngest:quick": "curl -X POST http://localhost:3010/api/admin/scrape-inngest -H 'Content-Type: application/json' -d '{\"maxPages\": 3}'",
    "deploy:production": "./database-ops/deploy-production.sh",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "tree": "tree -I 'node_modules|postgres_data|.next' -L 3",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:setup": "tsx scripts/create-test-users.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "inngest": "^3.44.2",
    "next": "15.4.6",
    "next-auth": "^5.0.0-beta.29",
    "openai": "^6.16.0",
    "pg": "^8.16.3",
    "prisma": "^6.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
